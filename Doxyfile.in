# Doxyfile.in — Doxygen configuration for the Atomic Tanks public API reference.
# Configured by CMakeLists.txt (WP PF-1.12): @PROJECT_VERSION@ and paths are
# substituted at configure time, so the version cannot go stale.
# Only public headers are fed in; all warnings land in warnings.log inside the
# output directory, and the `doc` build target fails when that log is non-empty
# (see cmake/doc-fail-on-warnings.cmake), so coverage gaps stay visible until
# WP PF-1.12.3 lands. (WARN_AS_ERROR would abort on the first gap instead of
# listing them all, and this Doxygen build has no FAIL_ON_WARNING tag.)

DOXYFILE_ENCODING  = UTF-8
PROJECT_NAME       = "Atomic Tanks"
PROJECT_NUMBER     = @PROJECT_VERSION@
OUTPUT_DIRECTORY   = @DOXYGEN_OUTPUT_DIR@
CREATE_SUBDIRS     = NO
INPUT              = @PROJECT_SOURCE_DIR@/src
INPUT_ENCODING     = UTF-8
FILE_PATTERNS      = *.h
RECURSIVE          = NO
EXCLUDE            = @PROJECT_SOURCE_DIR@/src/extern
EXCLUDE_PATTERNS   = */resource.h
EXTRACT_ALL        = NO
EXTRACT_PRIVATE    = NO
EXTRACT_STATIC     = NO
GENERATE_HTML      = YES
GENERATE_LATEX     = NO
GENERATE_MAN       = NO
WARNINGS           = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR  = YES
WARN_NO_PARAMDOC   = NO
WARN_AS_ERROR      = NO
WARN_LOGFILE       = @DOXYGEN_OUTPUT_DIR@/warnings.log
QUIET              = NO
