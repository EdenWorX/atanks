/* Build configuration generated by CMake from config.h.in. Do not edit. */
#ifndef ATANKS_CONFIG_H_INCLUDED
#define ATANKS_CONFIG_H_INCLUDED

/* Project version (single source of truth: project(VERSION ...) in CMakeLists.txt). */
#define VERSION "@PROJECT_VERSION@"

/* Data directory baked into the binary (ATANKS_DATA_DIR cache variable). */
#define DATA_DIR "@ATANKS_DATA_DIR@"

/* Defined for builds with network support (Linux and BSD only). */
#cmakedefine NETWORK

/* Defined when libcurl was found: enables the GitHub release update checker (TODO-PF-2). */
#cmakedefine ATANKS_HAVE_CURL

/* Platform flag plumbing moved from -DLINUX / -DMACOSX. Only MACOSX has
 * consumers in the tree (src/files.cpp); LINUX is defined for parity. */
#cmakedefine ATANKS_PLATFORM_MACOSX
#ifdef ATANKS_PLATFORM_MACOSX
#  define MACOSX 1
#else
#  define LINUX 1
#endif

#endif // ATANKS_CONFIG_H_INCLUDED
